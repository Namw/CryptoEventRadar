# App
APP_ENV=dev
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./data/app.db

# LLM
OPENAI_API_KEY=sk-b171c11d1da34660a08f084c8c7af7c5
OPENAI_MODEL=deepseek-v4-pro
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_TIMEOUT_SECONDS=20

# Tool Router
# values: rules | langchain_mcp
TOOL_ROUTER_BACKEND=rules

# Alert Notify
# values: console | webhook | both
# webhook（需配置 ALERT_WEBHOOK_URL）
ALERT_NOTIFY_CHANNEL=console
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_SECONDS=8

# Sources
BINANCE_SOURCE_ENABLED=true
NEWS_SOURCE_ENABLED=true

# Network (optional)
# Example: http://127.0.0.1:7890
BINANCE_PROXY_URL=http://127.0.0.1:7897