# Copy from .env.example and fill values
APP_ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/app.db
OPENAI_API_KEY=
OPENAI_MODEL=
BINANCE_SOURCE_ENABLED=true
NEWS_SOURCE_ENABLED=true

# Fill this with your VPN local proxy endpoint
# Example: http://127.0.0.1:7890
BINANCE_PROXY_URL=http://127.0.0.1:7897
