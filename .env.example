# App
APP_ENV=dev
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./data/app.db

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=20

# Sources
BINANCE_SOURCE_ENABLED=true
NEWS_SOURCE_ENABLED=true

# Network (optional)
# Example: http://127.0.0.1:7890
BINANCE_PROXY_URL=
