# App
APP_ENV=dev
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./data/app.db

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=20

# Tool Router
# values: rules | langchain_mcp
TOOL_ROUTER_BACKEND=rules

# Alert Notify
# values: console | webhook | both
ALERT_NOTIFY_CHANNEL=console
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_SECONDS=8

# Sources
BINANCE_SOURCE_ENABLED=true
NEWS_SOURCE_ENABLED=true

# Network (optional)
# Example: http://127.0.0.1:7890
BINANCE_PROXY_URL=
